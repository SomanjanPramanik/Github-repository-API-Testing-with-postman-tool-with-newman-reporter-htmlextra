      "name": "Checking for creating duplicate repository for authenticated user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//verify satus code\r",
              "pm.test(\"Verify status code for a duplicate repository which is created for a valid account\", function () {\r",
              "    pm.expect(pm.response.code).to.equal(422);\r",
              "});\r",
              "\r",
              "//verify satus message\r",
              "pm.test(\"Verify status message for a duplicate repository which is created for a valid account\", function () {\r",
              "    pm.expect(pm.response.status).to.equal(\"Unprocessable Entity\");\r",
              "});\r",
              "\r",
              "//verify response time to be less than 2000 milisec : 2 sec\r",
              "pm.test(\"Verify response time to be less than 2000 milisec for a duplicate repository which is created for a valid account\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "//verify response body\r",
              "pm.test(\"Verify response body for a duplicate repository which is created for a valid account\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.message).to.equal(\"Repository creation failed.\");\r",
              "    pm.expect(response.status).to.equal(\"422\");\r",
              "    pm.expect(response.errors[0].message).to.equal(\"name already exists on this account\");\r",
              "});"
