    {
      "name": "Checking for creating new repository for authenticated user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//verify satus code\r",
              "pm.test(\"Verify status code for a new repository which is created for a valid account\", function () {\r",
              "    pm.expect(pm.response.code).to.equal(201);\r",
              "});\r",
              "\r",
              "//verify satus message\r",
              "pm.test(\"Verify status message for a new repository which is created for a valid account\", function () {\r",
              "    pm.expect(pm.response.status).to.equal(\"Created\");\r",
              "});\r",
              "\r",
              "//verify response time to be less than 2000 milisec : 2 sec\r",
              "pm.test(\"Verify response time to be less than 2000 milisec for a new repository which is created for a valid account\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);\r",
              "});\r",
              "\r",
              "//verify response body\r",
              "pm.test(\"Verify response body for a new repository which is created for a valid account\", function () {\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.name).to.equal(pm.environment.get(\"repository\"));\r",
              "    pm.expect(response.description).to.equal(pm.environment.get(\"description\"));   \r",
              "    pm.expect(response.full_name).to.equal(pm.environment.get(\"user\") + \"/\" + pm.environment.get(\"repository\"));\r",
              "    pm.expect(response.owner.login).to.equal(pm.environment.get(\"user\"));\r",
              "    pm.expect(response.private).to.equal(true);\r",
              "});\r",
              "\r",
              "pm.environment.set(\"private\",true);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{Bearer_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/vnd.github+json",
            "type": "text"
          }
        ],
        "body": {
