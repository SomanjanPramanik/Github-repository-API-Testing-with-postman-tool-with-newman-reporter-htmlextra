    {
      "name": "Checking if there is any repository should be there before creating one",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//verify satus code\r",
              "pm.test(\"Verify status code for a repository which doesn't exist for a valid account\", function () {\r",
              "    pm.expect(pm.response.code).to.equal(404);\r",
              "});\r",
              "\r",
              "//verify satus message\r",
              "pm.test(\"Verify status message for a repository which doesn't exist for a valid account\", function () {\r",
              "    pm.expect(pm.response.status).to.equal(\"Not Found\");\r",
              "});\r",
              "\r",
              "//verify response time to be less than 2000 milisec : 2 sec\r",
              "pm.test(\"Verify response time to be less than 2000 milisec for a repository which doesn't exist for a valid account\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "//verify response body\r",
              "pm.test(\"Verify response body for a repository which doesn't exist for a valid account\", function () {\r",
              "   //first get the json data \r",
              "   const response = pm.response.json();\r",
              "   pm.expect(response.message).to.equal(\"Not Found\");\r",
              "   pm.expect(response.status).to.equal(\"404\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
