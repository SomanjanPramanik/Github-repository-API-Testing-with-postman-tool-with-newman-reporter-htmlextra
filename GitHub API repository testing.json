    {
      "name": "Checking for updating [private to public] existing repository for authentic user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "//verify satus code\r",
              "pm.test(\"Verify status code for updating repository visibility to public\", function () {\r",
              "    pm.expect(pm.response.code).to.equal(200);\r",
              "});\r",
              "\r",
              "//verify satus message\r",
              "pm.test(\"Verify status message for updating repository visibility to public\", function () {\r",
              "    pm.expect(pm.response.status).to.equal(\"OK\");\r",
              "});\r",
              "\r",
              "//verify response time to be less than 2000 milisec : 2 sec\r",
              "pm.test(\"Verify response time to be less than 2000 milisec for updating repository visibility to public\", function () {\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
              "});\r",
              "\r",
              "//verify the response body\r",
              "pm.test(\"Verify the response body for updating repository visibility to public\", function () {\r",
              "    //get the response body first\r",
              "    const response = pm.response.json();\r",
              "    pm.expect(response.private).to.equal(false);\r",
              "    pm.expect(response.name).to.equal(pm.environment.get(\"repository\"));\r",
              "})\r",
              "\r",
              "//sync with environment with variable\r",
              "pm.environment.set(\"private\", false);"
            ],
